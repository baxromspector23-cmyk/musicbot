# Required
BOT_TOKEN=123456:ABC-your-token-from-BotFather
OWNER_ID=123456789

# Webhook (leave WEBHOOK_URL and RENDER_EXTERNAL_URL empty locally -> long polling)
WEBHOOK_SECRET=
WEBHOOK_URL=
# RENDER_EXTERNAL_URL is set automatically by Render

# Optional Core
PORT=10000
TEMP_ROOT=/tmp/musicbot
MAX_DOWNLOAD_MB=20
MAX_UPLOAD_MB=50
SESSION_TTL_MIN=30
FFMPEG_TIMEOUT_SEC=600
MAX_DURATION_MIN=60
LOG_LEVEL=INFO

# Database (sqlite default locally, postgres on Render e.g. Neon/Supabase)
DATABASE_URL=sqlite+aiosqlite:///./data.db

# Instagram Reels Auto-Poster
TOKEN_ENC_KEY=
IG_LOGIN_MODE=instagram
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_APP_ID=
IG_APP_SECRET=
IG_API_VERSION=v25.0

# LLM for Captions & Hashtags (provider: gemini or anthropic)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CAPTION_LANG=uz
BRAND_HASHTAG=
DEFAULT_HASHTAGS=reels,uzbekistan,tashkent,video,trend
HASHTAG_LIMIT=5

# Scheduling & Best-Time Engine
TZ=Asia/Tashkent
MAX_POSTS_PER_DAY=2
MIN_GAP_HOURS=4
QUIET_HOURS=0-7
STORAGE_CHAT_ID=
TICK_SECRET=change-this-tick-secret
SCHEDULER_INTERVAL_SEC=30
MAX_REEL_MB=19
