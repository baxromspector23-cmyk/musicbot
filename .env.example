# Required
BOT_TOKEN=123456:ABC-your-token-from-BotFather
OWNER_ID=123456789

# Webhook (leave WEBHOOK_URL and RENDER_EXTERNAL_URL empty locally -> long polling)
WEBHOOK_SECRET=
WEBHOOK_URL=
# RENDER_EXTERNAL_URL is set automatically by Render

# Optional
PORT=10000
TEMP_ROOT=/tmp/musicbot
MAX_DOWNLOAD_MB=20
MAX_UPLOAD_MB=50
SESSION_TTL_MIN=30
FFMPEG_TIMEOUT_SEC=600
MAX_DURATION_MIN=60
LOG_LEVEL=INFO
